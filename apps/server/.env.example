# 复制为 .env 并填入真实值（.env 不会被提交）
# Homebrew 安装的 MySQL 默认 root 无密码；若你设过密码，写成 root:your-password
DATABASE_URL="mysql://root@localhost:3306/match_point"
# 至少 32 位随机串，缺失或过短会导致服务启动失败
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
PORT=3000
# 逗号分隔的 CORS 白名单；不填在开发期允许所有来源。
# NODE_ENV=production 时不填会直接启动失败（避免误把「放开所有来源」带上线）
CORS_ORIGIN="http://localhost:5173"
# 上传图片的对外基地址，用于拼绝对 URL（小程序 <image> 加载不了相对路径）。
# 生产环境必须改成真实域名/OSS 地址，否则前端拿到的图片地址会指向 localhost。
PUBLIC_BASE_URL="http://localhost:3000"
