{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    // 用 Bundler 而非 NodeNext：server 只经 tsx 运行，且要直接消费 packages/shared 的源码
    // （NodeNext 会强制 shared 内的相对导入都带 .ts 扩展名）
    "moduleResolution": "Bundler",
    "types": ["node"],
    "outDir": "dist",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src/**/*.ts", "../../packages/shared/src/**/*.ts"]
}